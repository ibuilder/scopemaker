# Normalise line endings so a Windows checkout cannot produce a broken build.
* text=auto eol=lf

# Shell scripts and the Dockerfile are executed by Linux inside the container.
# A CRLF checkout makes the shebang read as "/bin/sh\r" and the container exits
# with "bad interpreter", so force LF regardless of platform or core.autocrlf.
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-entrypoint.sh text eol=lf

# Batch files genuinely need CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary assets: never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.docx          binary
*.woff          binary
*.woff2         binary

# Keep generated/vendored files out of language statistics and diffs.
migrations/versions/*.py linguist-generated=false
docs/index.html          linguist-documentation
