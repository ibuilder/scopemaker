# ---------------------------------------------------------------------------
# ScopeMaker configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Which config class to load: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi:app

# ---------------------------------------------------------------------------
# Security (REQUIRED in production)
# ---------------------------------------------------------------------------
# Session signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Fernet key used to encrypt third-party OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates every stored Procore connection.
ENCRYPTION_KEY=

# Comma-separated hostnames the app will serve. Blocks Host-header attacks.
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 behind a TLS-terminating proxy so cookies get the Secure flag
# and ProxyFix trusts X-Forwarded-*.
FORCE_HTTPS=0
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Dev default is SQLite. Production should be PostgreSQL:
#   postgresql+psycopg://scopemaker:password@localhost:5432/scopemaker
DATABASE_URL=sqlite:///scopemaker.sqlite3

# ---------------------------------------------------------------------------
# Rate limiting (Flask-Limiter storage)
# In-memory is fine for a single process; use Redis for multi-worker deploys.
# ---------------------------------------------------------------------------
# In-memory storage is PER WORKER PROCESS, so limits are silently multiplied
# by the worker count. Use Redis for any multi-worker deployment.
RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# Document rendering
# ---------------------------------------------------------------------------
# Every export is cached by document fingerprint, so an unchanged scope is
# served from stored bytes without rendering anything.
#
# With RENDER_ASYNC=1 a render that IS needed is handed to a worker process and
# the request returns a waiting page instead of blocking for a second or two.
# It requires at least one worker:  flask run-worker
# Leave it off if you are not running one, or exports will never complete.
RENDER_ASYNC=0

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
# /metrics serves Prometheus text exposition. It returns 404 until this is set,
# then requires  Authorization: Bearer <token>.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Registration policy
# open      - anyone may register and create an organization
# invite    - registration only via an org invite token
# closed    - no self-service registration; admins create users
# ---------------------------------------------------------------------------
REGISTRATION_MODE=open

# ---------------------------------------------------------------------------
# Procore integration (optional - the app is fully usable without it)
# ---------------------------------------------------------------------------
PROCORE_ENABLED=0
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
# Production: https://api.procore.com   Sandbox: https://sandbox.procore.com
PROCORE_API_BASE=https://api.procore.com
PROCORE_LOGIN_BASE=https://login.procore.com
# Must exactly match the redirect URI registered in the Procore Developer Portal
PROCORE_REDIRECT_URI=http://localhost:5000/procore/callback
# Developer Managed Service Account company id, for unattended client-credentials sync
PROCORE_DMSA_COMPANY_ID=

# ---------------------------------------------------------------------------
# OIDC single sign-on (optional)
# ---------------------------------------------------------------------------
OIDC_ENABLED=0
OIDC_NAME=sso
OIDC_DISPLAY_NAME=Single Sign-On
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# Comma-separated email domains allowed to sign in via SSO. Empty = allow all.
OIDC_ALLOWED_DOMAINS=
# Organization slug that SSO users are auto-provisioned into
OIDC_DEFAULT_ORG=
OIDC_SCOPES=openid email profile

# ---------------------------------------------------------------------------
# Email (REQUIRED in production)
# Without a working relay, password resets and invitations cannot be delivered
# and a user who forgets their password is locked out permanently.
# Leave MAIL_SERVER blank in development: the reset link is written to the log.
# ---------------------------------------------------------------------------
# console | smtp | null. Blank picks smtp when MAIL_SERVER is set, else console.
MAIL_BACKEND=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=scopemaker@localhost
MAIL_SENDER_NAME=ScopeMaker

# ---------------------------------------------------------------------------
# Account security
# ---------------------------------------------------------------------------
# How long a password reset link stays valid.
PASSWORD_RESET_HOURS=2
# Failed sign-ins before an account is temporarily locked. Counted per account,
# not per IP -- an IP limit does nothing against credential stuffing spread
# across many addresses.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
